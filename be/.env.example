# Supabase Postgres connection string (transaction pooler, port 6543).
# Dashboard -> Project Settings -> Database -> URI. Use the asyncpg driver prefix.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Offline development without a Supabase project:
# DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
ML_BASE_URL=http://127.0.0.1:8100
CORS_ORIGINS=*
AUTO_SEED=true

# Optional. Flutter reads the catalog with the anon key.
# Contribution writes still go through this API so review stays in one place.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=
